{
  "mcpServers": {
    "astaroth": {
      "type": "stdio",
      "command": "~/astaroth/env/bin/python",
      "args": [
        "~/astaroth/astaroth_mcp.py"
      ],
      "env": {
        "EMBED_MODEL": "nomic-embed-text",
        "OLLAMA_EMBED_URL": "http://localhost:11434/api/embed",
        "ANTHROPIC_API_KEY": "",
        "ASTAROTH_MODEL": "claude-haiku-4-5",
        "ASTAROTH_MAX_TOKENS": "1024"
      }
    }
  }
}
